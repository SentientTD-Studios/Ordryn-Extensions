{
  "id": "discord",
  "name": "Discord",
  "version": "1.3.0",
  "host_api": 1,
  "description": "Post task events from this project to a Discord channel using an incoming webhook.",
  "hooks": [
    {
      "on": "task.created"
    },
    {
      "on": "task.updated"
    },
    {
      "on": "task.deleted"
    },
    {
      "on": "task.commented"
    },
    {
      "on": "task.claimed"
    },
    {
      "on": "task.unclaimed"
    },
    {
      "on": "task.due_changed"
    },
    {
      "on": "task.moved"
    },
    {
      "on": "task.tagged"
    },
    {
      "on": "task.overdue"
    },
    {
      "on": "task.reordered"
    },
    {
      "on": "project.updated"
    }
  ],
  "delivery": {
    "type": "discord.webhook",
    "url_from": "webhook_url"
  },
  "settings": [
    {
      "key": "webhook_url",
      "type": "secret",
      "label": "Channel webhook URL",
      "description": "Create a webhook in Discord (channel settings \u2192 Integrations \u2192 Webhooks) and paste the URL here.",
      "required": true,
      "scope": "project"
    },
    {
      "key": "triggers",
      "type": "hook_select",
      "label": "Triggers",
      "description": "Choose which task events should post to this channel.",
      "scope": "project"
    },
    {
      "key": "status_only",
      "type": "bool",
      "label": "Only notify when status changes (for task.updated)",
      "description": "When enabled, task.updated is skipped unless the kanban or list status actually changed.",
      "scope": "project"
    },
    {
      "key": "skip_self",
      "type": "bool",
      "label": "Skip events I caused",
      "description": "Do not post when you are the actor.",
      "scope": "project"
    },
    {
      "key": "claimed_only",
      "type": "bool",
      "label": "Only claimed tasks",
      "description": "Skip events for tasks that nobody has claimed.",
      "scope": "project"
    },
    {
      "key": "min_priority",
      "type": "priority",
      "label": "Minimum priority",
      "description": "Ignore events below this priority.",
      "scope": "project"
    },
    {
      "key": "tag_ids",
      "type": "tag_ids",
      "label": "Only these tags",
      "description": "If any tags are selected, only matching tasks notify.",
      "scope": "project"
    },
    {
      "key": "digest",
      "type": "digest",
      "label": "Digest",
      "description": "Batch notifications hourly or daily instead of sending immediately.",
      "scope": "project"
    }
  ],
  "templates": {
    "task.created": "New task **{name}** in **{project}** ({url})",
    "task.updated": "Task **{name}** updated to **{status}** in project **{project}**",
    "task.deleted": "Task **{name}** deleted from **{project}**",
    "task.commented": "{actor} commented on **{name}**: {comment} ({url})",
    "task.claimed": "{actor} claimed **{name}** in **{project}**",
    "task.unclaimed": "{actor} unclaimed **{name}** in **{project}**",
    "task.due_changed": "Due date for **{name}** is now {due_date} ({url})",
    "task.moved": "**{name}** moved in **{project}** (sprint {sprint})",
    "task.tagged": "Tags on **{name}**: {tags}",
    "task.overdue": "**{name}** is overdue ({due_date}) in **{project}** ({url})",
    "task.reordered": "{count} tasks reordered in **{project}**",
    "project.updated": "Project **{project}** was updated by {actor}"
  },
  "controls": [
    "send_test",
    "sample_json"
  ]
}
