{
  "id": "webhook",
  "name": "Generic webhook",
  "version": "1.1.0",
  "host_api": 1,
  "description": "Post task events from this project to any public HTTPS webhook (n8n, Zapier, Mattermost, Google Chat, custom listeners, and similar).",
  "hooks": [
    { "on": "task.created" },
    { "on": "task.updated" },
    { "on": "task.deleted" },
    { "on": "task.commented" },
    { "on": "task.claimed" },
    { "on": "task.unclaimed" },
    { "on": "task.due_changed" },
    { "on": "task.moved" },
    { "on": "task.tagged" },
    { "on": "task.overdue" },
    { "on": "task.reordered" },
    { "on": "project.updated" },
    { "on": "join.request" }
  ],
  "delivery": {
    "type": "http.webhook",
    "url_from": "webhook_url",
    "format": "json"
  },
  "settings": [
    {
      "key": "webhook_url",
      "type": "secret",
      "label": "Webhook URL",
      "description": "HTTPS URL of the receiver. Private, loopback, and link-local addresses are rejected. Site-level URL (Admin) is used only for join.request.",
      "required": true,
      "scope": "project"
    },
    {
      "key": "triggers",
      "type": "hook_select",
      "label": "Triggers",
      "description": "Choose which task events should be posted.",
      "scope": "project"
    },
    {
      "key": "status_only",
      "type": "bool",
      "label": "Only notify when status changes (for task.updated)",
      "description": "When enabled, task.updated is skipped unless the kanban or list status actually changed.",
      "scope": "project"
    }
  ],
  "templates": {
    "task.created": "New task {name} in {project} ({url})",
    "task.updated": "Task {name} updated to {status} in project {project}",
    "task.deleted": "Task {name} deleted from {project}",
    "task.commented": "{actor} commented on {name}: {comment} ({url})",
    "task.claimed": "{actor} claimed {name} in {project}",
    "task.unclaimed": "{actor} unclaimed {name} in {project}",
    "task.due_changed": "Due date for {name} is now {due_date}",
    "task.moved": "{name} moved in {project} (sprint {sprint})",
    "task.tagged": "Tags on {name}: {tags}",
    "task.overdue": "{name} is overdue ({due_date}) in {project}",
    "task.reordered": "{count} tasks reordered in {project}",
    "project.updated": "Project {project} was updated by {actor}",
    "join.request": "New join request from {join_email}: {join_message}"
  }
}
